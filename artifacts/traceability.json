{
  "schema_version": "1.1.0",
  "specifications": [
    {
      "path": "specs/architecture/SPEC-100-system-architecture.md",
      "requirements": [
        {
          "id": "ARCH-NET-0001",
          "priority": "critical",
          "release_gate": "security",
          "statement": "Production application and model workloads MUST operate with deny-by-default egress.",
          "verification": [
            "TEST-SEC-0001"
          ]
        },
        {
          "id": "ARCH-TEL-0002",
          "priority": "critical",
          "release_gate": "security",
          "statement": "Telemetry MUST remain disabled unless an approved internal endpoint is explicitly configured.",
          "verification": [
            "TEST-UNIT-0004"
          ]
        },
        {
          "id": "ARCH-REL-0003",
          "priority": "critical",
          "release_gate": "operational",
          "statement": "Source loss MUST produce explicit staleness and uncertainty behavior rather than silent continuity.",
          "verification": [
            "TEST-RES-0001"
          ]
        }
      ],
      "spec_id": "SPEC-100",
      "standards": [
        "NIST-SP-800-218",
        "ISO-IEC-25010"
      ],
      "status": "accepted"
    },
    {
      "path": "specs/architecture/SPEC-110-weather-acquisition-boundary.md",
      "requirements": [
        {
          "id": "SEC-EGRESS-0001",
          "priority": "critical",
          "release_gate": "security",
          "statement": "Only approved acquisition workloads MAY establish external provider connections; serving, forecast, calibration, and visualization workloads MUST NOT have arbitrary Internet egress.",
          "verification": [
            "TEST-DEPLOY-0001"
          ]
        },
        {
          "id": "SEC-WORKLOAD-0002",
          "priority": "critical",
          "release_gate": "security",
          "statement": "Weather acquisition workloads MUST run as non-root, MUST drop Linux capabilities, MUST prohibit privilege escalation, and SHOULD use a read-only root filesystem.",
          "verification": [
            "TEST-DEPLOY-0001"
          ]
        },
        {
          "id": "SEC-SECRET-0003",
          "priority": "critical",
          "release_gate": "security",
          "statement": "Provider credentials MUST NOT be delivered to browser clients or recorded in source data, provenance, logs, traces, metrics labels, or release evidence.",
          "verification": [
            "TEST-SECRET-0001"
          ]
        }
      ],
      "spec_id": "SPEC-110",
      "standards": [
        "RFC-8446",
        "NIST-SSDF-1.1",
        "KUBERNETES-NETWORKPOLICY"
      ],
      "status": "review"
    },
    {
      "path": "specs/data/SPEC-200-observation-platform.md",
      "requirements": [
        {
          "id": "DATA-RAW-0001",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "The original source message MUST be retained before interpretation or transformation.",
          "verification": [
            "TEST-UNIT-0001"
          ]
        },
        {
          "id": "DATA-TIME-0002",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "Observation time, ingestion time, and source publication time MUST be represented independently when available.",
          "verification": [
            "TEST-SCHEMA-0001"
          ]
        },
        {
          "id": "DATA-QC-0003",
          "priority": "high",
          "release_gate": "engineering",
          "statement": "Every observation MUST carry an explicit quality disposition and quality flags.",
          "verification": [
            "TEST-SCHEMA-0001"
          ]
        }
      ],
      "spec_id": "SPEC-200",
      "standards": [
        "WMO-WIS2",
        "WMO-306",
        "CF-CONVENTIONS"
      ],
      "status": "implemented"
    },
    {
      "path": "specs/data/SPEC-210-data-model.md",
      "requirements": [
        {
          "id": "DATA-UNIT-0001",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "Canonical values MUST include an explicit unit and MUST NOT infer units from field names.",
          "verification": [
            "TEST-SCHEMA-0001"
          ]
        },
        {
          "id": "DATA-GEO-0002",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "Interchange geometry MUST use GeoJSON longitude and latitude ordering.",
          "verification": [
            "TEST-SCHEMA-0001"
          ]
        },
        {
          "id": "DATA-MISS-0003",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "Missing values MUST remain distinguishable from measured zero and trace values.",
          "verification": [
            "TEST-SCHEMA-0001"
          ]
        }
      ],
      "spec_id": "SPEC-210",
      "standards": [
        "RFC-3339",
        "RFC-7946",
        "CF-CONVENTIONS"
      ],
      "status": "implemented"
    },
    {
      "path": "specs/data/SPEC-220-source-slices.md",
      "requirements": [
        {
          "id": "ACQ-SRC-0001",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "Every selectively retrieved provider byte range MUST produce an immutable source-slice manifest containing the upstream object identity, exact inclusive byte interval, index digest, payload digest, and acquisition timestamps.",
          "verification": [
            "TEST-SOURCE-0001"
          ]
        },
        {
          "id": "ACQ-HASH-0002",
          "priority": "critical",
          "release_gate": "security",
          "statement": "The platform MUST calculate a SHA-256 digest for retained source bytes and MUST NOT treat a provider ETag as a cryptographic content identity.",
          "verification": [
            "TEST-SOURCE-0001"
          ]
        },
        {
          "id": "ACQ-RANGE-0003",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "A source byte interval MUST be non-negative, ordered, and bounded by the declared upstream object length before it is admitted.",
          "verification": [
            "TEST-SOURCE-0001"
          ]
        },
        {
          "id": "ACQ-TIME-0004",
          "priority": "high",
          "release_gate": "engineering",
          "statement": "Discovery, download, receipt, and retention timestamps MUST be timezone-aware and MUST preserve their monotonic acquisition order.",
          "verification": [
            "TEST-SOURCE-0001"
          ]
        }
      ],
      "spec_id": "SPEC-220",
      "standards": [
        "RFC-3339",
        "SHA-256",
        "WMO-GRIB2"
      ],
      "status": "implemented"
    },
    {
      "path": "specs/data/SPEC-230-gridded-guidance.md",
      "requirements": [
        {
          "id": "DATA-GRID-0001",
          "priority": "critical",
          "release_gate": "architecture",
          "statement": "Gridded model guidance MUST be represented as a canonical grid asset and MUST NOT be expanded into one point observation per grid cell.",
          "verification": [
            "TEST-GRID-0001"
          ]
        },
        {
          "id": "DATA-GRID-TIME-0002",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Every grid asset MUST identify model initialization time, valid time, and lead, and valid time MUST equal initialization time plus lead.",
          "verification": [
            "TEST-GRID-0001"
          ]
        },
        {
          "id": "DATA-LINEAGE-0003",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "Every grid asset MUST retain immutable source and normalized content digests, source revision, decoder version, unit, grid identity, and provenance.",
          "verification": [
            "TEST-GRID-0001",
            "TEST-SCHEMA-0002"
          ]
        },
        {
          "id": "DATA-ENSEMBLE-0004",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Ensemble guidance MUST preserve the provider member identifier and MUST NOT collapse distinct members into an unlabelled deterministic field.",
          "verification": [
            "TEST-GRID-0001"
          ]
        },
        {
          "id": "DATA-QUALITY-0005",
          "priority": "high",
          "release_gate": "scientific",
          "statement": "An accepted grid asset MUST NOT carry unresolved quality flags; suspect assets SHOULD be admitted only with an explicit non-accept disposition.",
          "verification": [
            "TEST-GRID-0001"
          ]
        }
      ],
      "spec_id": "SPEC-230",
      "standards": [
        "RFC-3339",
        "CF-CONVENTIONS",
        "WMO-GRIB2"
      ],
      "status": "implemented"
    },
    {
      "path": "specs/models/SPEC-400-model-guidance-catalog.md",
      "requirements": [
        {
          "id": "MODEL-CAT-0001",
          "priority": "critical",
          "release_gate": "governance",
          "statement": "Imported, platform-generated, official-warning, and experimental guidance MUST be labeled distinctly and MUST NOT be conflated.",
          "verification": [
            "TEST-CONTRACT-0001"
          ]
        },
        {
          "id": "MODEL-CAT-0002",
          "priority": "high",
          "release_gate": "engineering",
          "statement": "Missing and partial model cycles MUST be represented explicitly rather than as silently absent data.",
          "verification": [
            "TEST-CATALOG-0001"
          ]
        }
      ],
      "spec_id": "SPEC-400",
      "standards": [
        "WMO-306",
        "NIST-AI-RMF"
      ],
      "status": "implemented"
    },
    {
      "path": "specs/models/SPEC-410-calibration.md",
      "requirements": [
        {
          "id": "MODEL-CAL-0001",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Calibration MUST be trained, tuned, and evaluated on temporally separated datasets.",
          "verification": [
            "TEST-SCI-0001"
          ]
        },
        {
          "id": "MODEL-CAL-0002",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Ensemble fusion MUST account for model-error dependence and MUST NOT treat correlated variants as independent evidence.",
          "verification": [
            "TEST-UNIT-0003"
          ]
        },
        {
          "id": "MODEL-CAL-0003",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Forecast probabilities and quantiles MUST satisfy boundedness and monotonicity invariants.",
          "verification": [
            "TEST-UNIT-0002"
          ]
        }
      ],
      "spec_id": "SPEC-410",
      "standards": [
        "NIST-AI-RMF",
        "ISO-IEC-5259"
      ],
      "status": "accepted"
    },
    {
      "path": "specs/models/SPEC-420-cycle-publication.md",
      "requirements": [
        {
          "id": "MODEL-CYCLE-0001",
          "priority": "critical",
          "release_gate": "operational",
          "statement": "Model-cycle publication state MUST be explicit and MUST distinguish missing, partial, minimum-usable, complete, quarantined, superseded, and expired states.",
          "verification": [
            "TEST-CYCLE-0001"
          ]
        },
        {
          "id": "MODEL-USABLE-0002",
          "priority": "critical",
          "release_gate": "operational",
          "statement": "A newer cycle MUST NOT replace the currently served usable cycle until its configured minimum required-field manifest is satisfied.",
          "verification": [
            "TEST-CYCLE-0001"
          ]
        },
        {
          "id": "MODEL-IDEMPOTENT-0003",
          "priority": "critical",
          "release_gate": "engineering",
          "statement": "Duplicate provider notifications and field arrivals MUST NOT inflate completeness or create duplicate logical field identities.",
          "verification": [
            "TEST-CYCLE-0001",
            "TEST-GRIB-0001"
          ]
        },
        {
          "id": "MODEL-ALIAS-0004",
          "priority": "high",
          "release_gate": "ux",
          "statement": "The catalog SHOULD expose distinct latest-published, latest-usable, and latest-complete aliases, and user-facing defaults MUST resolve latest-usable.",
          "verification": [
            "TEST-CYCLE-0001"
          ]
        }
      ],
      "spec_id": "SPEC-420",
      "standards": [
        "RFC-3339",
        "WMO-GRIB2"
      ],
      "status": "implemented"
    },
    {
      "path": "specs/program/SPEC-000-program-charter.md",
      "requirements": [
        {
          "id": "PROG-GOV-0001",
          "priority": "critical",
          "release_gate": "governance",
          "statement": "The platform MUST distinguish official warnings, imported guidance, platform-generated operational guidance, and experimental output.",
          "verification": [
            "TEST-CONTRACT-0001"
          ]
        },
        {
          "id": "PROG-GOV-0002",
          "priority": "critical",
          "release_gate": "governance",
          "statement": "Every production forecast product MUST bind software, model, configuration, calibration, schema, source policy, and validation evidence into one release unit.",
          "verification": [
            "TEST-TRACE-0001"
          ]
        }
      ],
      "spec_id": "SPEC-000",
      "standards": [
        "RFC-2119",
        "RFC-8174",
        "NIST-AI-RMF"
      ],
      "status": "accepted"
    },
    {
      "path": "specs/validation/SPEC-800-validation-plan.md",
      "requirements": [
        {
          "id": "VAL-BASE-0001",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Every candidate forecast method MUST be compared with declared operational, persistence, and climatological baselines when applicable.",
          "verification": [
            "TEST-SCI-0001"
          ]
        },
        {
          "id": "VAL-SLICE-0002",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Validation MUST report skill by lead time, region, season, regime, event magnitude, and observation density where sample size permits.",
          "verification": [
            "REPORT-SCORECARD-0001"
          ]
        },
        {
          "id": "VAL-LEAK-0003",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Historical evaluation MUST prevent use of data unavailable at the simulated forecast issuance time.",
          "verification": [
            "TEST-SCI-0002"
          ]
        }
      ],
      "spec_id": "SPEC-800",
      "standards": [
        "ISO-IEC-25010",
        "NIST-AI-RMF-MEASURE"
      ],
      "status": "accepted"
    },
    {
      "path": "specs/validation/SPEC-810-weather-scientific-validation.md",
      "requirements": [
        {
          "id": "SCI-LON-0001",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Longitude normalization MUST use wrapped GeoJSON longitude semantics and MUST preserve antimeridian proximity.",
          "verification": [
            "TEST-WIND-0001"
          ]
        },
        {
          "id": "SCI-WIND-0002",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Meteorological wind direction conversion MUST produce physical U and V components whose cardinal signs correspond to motion away from the reported source direction.",
          "verification": [
            "TEST-WIND-0001"
          ]
        },
        {
          "id": "SCI-TILE-0003",
          "priority": "critical",
          "release_gate": "scientific",
          "statement": "Vector tile encoding and decoding MUST be deterministic, MUST reject non-finite values and malformed lengths, and MUST bound component reconstruction error by the declared quantization scale.",
          "verification": [
            "TEST-TILE-0001"
          ]
        },
        {
          "id": "UX-WEATHER-0004",
          "priority": "critical",
          "release_gate": "ux",
          "statement": "A weather client MUST distinguish observation, deterministic forecast, ensemble consensus, official warning, and experimental output and MUST expose initialization time, valid time, lead, source, and staleness.",
          "verification": [
            "TEST-UX-0001"
          ]
        },
        {
          "id": "UX-MOTION-0005",
          "priority": "high",
          "release_gate": "ux",
          "statement": "A weather client MUST provide reduced-motion and non-WebGL fallbacks without removing the underlying forecast information.",
          "verification": [
            "TEST-UX-0001"
          ]
        }
      ],
      "spec_id": "SPEC-810",
      "standards": [
        "OGC-API-EDR-1.1",
        "WCAG-2.2-AA"
      ],
      "status": "review"
    }
  ],
