{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weather:model-cycle-catalog:1",
  "title": "Model guidance cycle catalog entry",
  "type": "object",
  "required": [
    "model_id", "model_version", "guidance_origin", "initialized_at",
    "source_revision", "grids", "expected_fields"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "guidance_origin": {
      "enum": ["official_warning", "imported", "platform", "experimental"]
    },
    "initialized_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "minLength": 1},
    "grids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_fields": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/field"}
    },
    "available_fields": {
      "type": "array",
      "items": {"$ref": "#/$defs/field"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": ["variable", "level_type", "grid", "lead_hours"],
      "properties": {
        "variable": {"type": "string", "minLength": 1},
        "level_type": {"type": "string", "minLength": 1},
        "level_value": {"type": ["number", "null"]},
        "grid": {"type": "string", "minLength": 1},
        "lead_hours": {"type": "integer", "minimum": 0},
        "member": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
