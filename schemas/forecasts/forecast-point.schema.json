{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weather:forecast-point:1",
  "title": "Probabilistic point forecast",
  "type": "object",
  "required": ["product_id", "phenomenon", "unit", "geometry", "issued_at", "valid_time", "quantiles", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product_id": {"type": "string", "minLength": 1},
    "phenomenon": {"type": "string"},
    "unit": {"type": "string"},
    "geometry": {"type": "object"},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_time": {"type": "string", "format": "date-time"},
    "quantiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["probability", "value"],
        "properties": {
          "probability": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "value": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "threshold_probabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operator", "threshold", "probability"],
        "properties": {
          "operator": {"enum": [">", ">=", "<", "<="]},
          "threshold": {"type": "number"},
          "probability": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "urn:weather:provenance:1"}}
  },
  "additionalProperties": false
}
